<html lang='en'>

  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width,initial-scale=1' />
    <title>QuoteBoard</title>
    <link rel='stylesheet' href='/public/style.css' />
  </head>

  <body>
    <h1>QuoteBoard</h1>

    <form method='post' action='/quotes'>
      <input name='author' placeholder='Author (optional)' />
      <textarea name='text' placeholder='Write a quote...' required></textarea>
      <button type='submit'>Add quote</button>
    </form>

    {{#if quotes.length}}
      {{#each quotes}}
        <div class='quote'>
          <div class='quote-text'>{{this.text}}</div>
          <div class='quote-author'>— {{this.author}}</div>
        </div>
      {{/each}}
    {{else}}
      <p style='color: #888;'>No quotes yet. Add the first one.</p>
    {{/if}}
  </body>

</html>